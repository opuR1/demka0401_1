<Window x:Class="demka1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demka1"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800" Background="{StaticResource MainBackground}" Icon="/Новые технологии.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="HeaderPanel" Background="{StaticResource SecondaryBackground}">
            <TextBlock x:Name="tbHeader" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" FontSize="20" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                <Button Content="Back" x:Name="btnBack" Visibility="Collapsed" Height="25" Width="50" Background="{StaticResource AccentActionBackground}" FontSize="14" FontWeight="Bold" Click="btnBack_Click"/>
            </StackPanel>
        </Grid>
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
    </Grid>
</Window>
