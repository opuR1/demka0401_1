<Page x:Class="demka1.Pages.OrderEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:demka1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderEdit" Background="{StaticResource MainBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Тип партнера:" FontSize="14" Margin="0,0,0,15"/>
                <TextBlock Text="Наименование:" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="Фамилия Директора:" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="Имя Директора:" FontSize="14" Margin="0,0,0,12"/>
                <TextBlock Text="Отчество Директора:" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="Индекс:" FontSize="14" Margin="0,0,0,12"/>
                <TextBlock Text="Регион:" FontSize="14" Margin="0,0,0,15"/>
                <TextBlock Text="Город:" FontSize="14" Margin="0,0,0,14"/>
                <TextBlock Text="Улица:" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="Дом:" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="Рейтинг:" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="Телефон:" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="Email:" FontSize="14" Margin="0,0,0,10"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <ComboBox x:Name="cmbPartnerTypes" Width="200" Margin="0,0,0,10"/>
                <TextBox x:Name="tbPartnerName" Width="200" Margin="0,0,0,10" />
                <TextBox x:Name="tbDirectorLN" Width="200" Margin="0,0,0,10" />
                <TextBox x:Name="tbDirectorFN" Width="200" Margin="0,0,0,10" />
                <TextBox x:Name="tbDirectorMN" Width="200" Margin="0,0,0,10" />
                <TextBox x:Name="tbIndex" Width="200" Margin="0,0,0,10" />
                <ComboBox x:Name="cmbRegion" Width="200" Margin="0,0,0,10"/>
                <ComboBox x:Name="cmbCity" Width="200" Margin="0,0,0,10"/>
                <TextBox x:Name="tbStreet" Width="200" Margin="0,0,0,10" />
                <TextBox x:Name="tbHouse" Width="200" Margin="0,0,0,10" />
                <TextBox x:Name="tbRating" Width="200" Margin="0,0,0,10" />
                <TextBox x:Name="tbPhone" Width="200" Margin="0,0,0,10" />
                <TextBox x:Name="tbEmail" Width="200" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Сохранить" x:Name="btnSave" Click="btnSave_Click" Margin="0,0,40,0" Width="80" Height="30"/>
                    <Button Content="Удалить" x:Name="btnDelete" Click="btnDelete_Click" Width="80" Height="30"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
